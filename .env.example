[TEMPLATE]
# Copy to .env (never commit .env) and adjust as needed.
# Both the API and `npm run dev` read this file from the project root.

# --- API -------------------------------------------------------------------
PORT=4000

# auto = Yahoo Finance chart API, with a deterministic synthetic feed as fallback
DATA_SOURCE=auto

# Sessions of daily history used by the risk engine
HISTORY_DAYS=756

# Paper portfolio net asset value in USD
PORTFOLIO_VALUE=1000000

# Scheduler interval in seconds (15 minutes)
MONITOR_INTERVAL_SECONDS=900

# Set to false for CLI-only runs
SCHEDULER_ENABLED=true

# Where SQLite and cached prices live (defaults to server/data; Docker sets /data)
DATA_DIR=

# Comma-separated browser origins allowed to call the API directly.
# The Next.js dashboard proxies /api, so the defaults are enough locally.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Dashboard -------------------------------------------------------------
# Server-side target of the Next.js /api rewrite
API_URL=http://127.0.0.1:4000

# --- Optional model narration ---------------------------------------------
# Leave empty for deterministic narration. Never expose this key to the browser.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
