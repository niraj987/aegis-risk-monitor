{
  "name": "aegis-risk-monitor",
  "version": "2.0.0",
  "private": true,
  "description": "Near-real-time portfolio risk monitoring: Express API + Next.js dashboard",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "setup": "npm --prefix server install && npm --prefix web install",
    "dev": "node scripts/dev.mjs",
    "build": "npm --prefix web run build",
    "start:api": "npm --prefix server start",
    "start:web": "npm --prefix web start",
    "test": "npm --prefix server test",
    "run:cycle": "npm --prefix server run run",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  }
}
